<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical"
    tools:context=".InicioActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top app bar -->
            <LinearLayout
                android:id="@+id/ly_top_bar"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/tv_titulo_app"
                    style="@style/TextoTituloApp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_name" />

                <FrameLayout
                    android:id="@+id/btn_cuenta"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/iv_cuenta"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/cd_cuenta"
                        android:src="@drawable/ic_cuenta" />
                </FrameLayout>
            </LinearLayout>

            <!-- Buscador -->
            <FrameLayout
                android:id="@+id/ly_buscador_fila"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:id="@+id/et_buscar"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_buscador"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:id="@+id/iv_buscar"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/cd_buscar"
                        android:src="@drawable/ic_buscar" />

                    <TextView
                        android:id="@+id/tv_buscar_hint"
                        style="@style/TextoBuscadorHint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:singleLine="true"
                        android:text="@string/buscar_hint" />
                </LinearLayout>
            </FrameLayout>

            <!-- Compra por edad -->
            <TextView
                android:id="@+id/tv_compra_por_edad"
                style="@style/TextoSeccion"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/seccion_compra_edad" />

            <LinearLayout
                android:id="@+id/rv_categorias"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="8dp">

        <LinearLayout
            android:id="@+id/ly_categoria_bebe"
            android:layout_width="104dp"
            android:layout_height="120dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_categoria"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="15dp">

            <View
                android:id="@+id/iv_categoria_bebe"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circulo_categoria" />

            <TextView
                android:id="@+id/tv_categoria_nombre_bebe"
                style="@style/TextoCategoriaNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/categoria_bebe" />

            <TextView
                android:id="@+id/tv_categoria_edad_bebe"
                style="@style/TextoCategoriaEdad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/edad_bebe" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ly_categoria_nina"
            android:layout_width="104dp"
            android:layout_height="120dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_categoria"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="15dp">

            <View
                android:id="@+id/iv_categoria_nina"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circulo_categoria" />

            <TextView
                android:id="@+id/tv_categoria_nombre_nina"
                style="@style/TextoCategoriaNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/categoria_nina" />

            <TextView
                android:id="@+id/tv_categoria_edad_nina"
                style="@style/TextoCategoriaEdad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/edad_nina_nino" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ly_categoria_nino"
            android:layout_width="104dp"
            android:layout_height="120dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_categoria"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="15dp">

            <View
                android:id="@+id/iv_categoria_nino"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circulo_categoria" />

            <TextView
                android:id="@+id/tv_categoria_nombre_nino"
                style="@style/TextoCategoriaNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/categoria_nino" />

            <TextView
                android:id="@+id/tv_categoria_edad_nino"
                style="@style/TextoCategoriaEdad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/edad_nina_nino" />
        </LinearLayout>
            </LinearLayout>

            <!-- Novedades -->
            <LinearLayout
                android:id="@+id/ly_novedades_cabecera"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/tv_novedades"
                    style="@style/TextoSeccion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/seccion_novedades" />

                <TextView
                    android:id="@+id/btn_ver_todo"
                    style="@style/TextoBoton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/btn_ver_todo" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/rv_novedades"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <include
                        layout="@layout/item_tarjeta_producto"
                        android:layout_width="156dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp" />

                    <include
                        layout="@layout/item_tarjeta_producto"
                        android:layout_width="156dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp" />

                    <include
                        layout="@layout/item_tarjeta_producto"
                        android:layout_width="156dp"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Aviso de cambio -->
            <FrameLayout
                android:id="@+id/ly_aviso_fila"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:id="@+id/ly_aviso_cambio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_aviso"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/iv_aviso_cambio"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_cambio_tienda" />

                    <LinearLayout
                        android:id="@+id/ly_aviso_textos"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_aviso_titulo"
                            style="@style/TextoTituloPequeno"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/aviso_titulo" />

                        <TextView
                            android:id="@+id/tv_aviso_texto"
                            style="@style/TextoApoyo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/aviso_texto" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Navigation bar -->
    <LinearLayout
        android:id="@+id/ly_navegacion"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@color/superficie_suave"
        android:orientation="horizontal"
        android:paddingTop="12dp">

        <LinearLayout
            android:id="@+id/btn_nav_inicio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/v_nav_indicador"
                android:layout_width="64dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_pildora">

                <ImageView
                    android:id="@+id/iv_nav_inicio"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_inicio" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_nav_inicio"
                style="@style/TextoNavegacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_inicio"
                android:textColor="@color/texto_principal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_nav_carrito"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="32dp">

                <ImageView
                    android:id="@+id/iv_nav_carrito"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_carrito" />

                <FrameLayout
                    android:id="@+id/ly_badge_carrito"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="34dp"
                    android:background="@drawable/bg_badge">

                    <TextView
                        android:id="@+id/tv_badge_carrito"
                        style="@style/TextoBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:includeFontPadding="false"
                        android:text="2" />
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/tv_nav_carrito"
                style="@style/TextoNavegacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_carrito" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_nav_favoritos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="32dp">

                <ImageView
                    android:id="@+id/iv_nav_favoritos"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_favorito" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_nav_favoritos"
                style="@style/TextoNavegacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_favoritos" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>